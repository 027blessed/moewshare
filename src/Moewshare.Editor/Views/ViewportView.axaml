<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moewshare.Editor.ViewModels"
             xmlns:v="using:Moewshare.Editor.Views"
             x:Class="Moewshare.Editor.Views.ViewportView"
             x:DataType="vm:ViewportPanelVM">
  <DockPanel>
    <!-- Панель вьюпорта -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="6,3">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
          <Button Classes="tool" Content="3D" Click="OnPerspectiveClick" ToolTip.Tip="3D перспектива" Margin="1"/>
          <Button Classes="tool" Content="🗺️ Изометрия" Click="OnIsometricClick" ToolTip.Tip="Изометрический вид (45°)" Margin="1"/>
          <Button Classes="tool" Content="📐 Сверху" Click="OnTopClick" ToolTip.Tip="Вид сверху" Margin="1"/>
          <Button Classes="tool" Content="🎮 Спереди 2D" Click="OnFrontClick" ToolTip.Tip="Вид спереди (2D)" Margin="1"/>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
          <Button Classes="icon" Classes.active="{Binding Editor.IsModeSelect}" Content="✋" Command="{Binding Editor.SetGizmoModeCommand}" CommandParameter="select" ToolTip.Tip="{Binding Editor.TipSelect}"/>
          <Button Classes="icon" Classes.active="{Binding Editor.IsModeTranslate}" Content="↔" Command="{Binding Editor.SetGizmoModeCommand}" CommandParameter="translate" ToolTip.Tip="{Binding Editor.TipMove}"/>
          <Button Classes="icon" Classes.active="{Binding Editor.IsModeRotate}" Content="🔄" Command="{Binding Editor.SetGizmoModeCommand}" CommandParameter="rotate" ToolTip.Tip="{Binding Editor.TipRotate}"/>
          <Button Classes="icon" Classes.active="{Binding Editor.IsModeScale}" Content="⤢" Command="{Binding Editor.SetGizmoModeCommand}" CommandParameter="scale" ToolTip.Tip="{Binding Editor.TipScale}"/>
          <Border Classes="vsep" Height="18"/>
          <Button Classes="icon" Content="🎯" Command="{Binding Editor.FocusOnSelectedCommand}" ToolTip.Tip="{Binding Editor.TipFocus}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 3D-вьюпорт -->
    <Border Margin="4" CornerRadius="10" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
      <v:ScenePreview x:Name="PreviewControl"/>
    </Border>
  </DockPanel>
</UserControl>
