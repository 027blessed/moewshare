<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moewshare.Editor.ViewModels"
             xmlns:v="using:Moewshare.Editor.Views"
             xmlns:ev="using:Moewshare.Engine.Events"
             x:Class="Moewshare.Editor.Views.EventGraphView"
             x:DataType="vm:EventGraphVM">

  <DockPanel Background="{DynamicResource SurfaceBrush}">
    <!-- ================= ПАНЕЛЬ ИНСТРУМЕНТОВ ================= -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="8,5">
      <WrapPanel Orientation="Horizontal">
        <!-- Переключатель: глобальный граф / граф объекта -->
        <Border Background="{DynamicResource Surface3Brush}" CornerRadius="8" Padding="2" Margin="0,2,8,2">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="tool" Classes.active="{Binding !IsObjectGraph}" Content="🌐 Глобальный"
                    Command="{Binding SelectGlobalGraphCommand}" ToolTip.Tip="Глобальные события сцены"/>
            <Button Classes="tool" Classes.active="{Binding IsObjectGraph}" Content="📦 Объект"
                    Command="{Binding SelectObjectGraphCommand}" ToolTip.Tip="Граф логики выбранного объекта"/>
          </StackPanel>
        </Border>
        <Border Classes="chip" Margin="0,2,10,2" MaxWidth="260" ToolTip.Tip="{Binding CurrentTargetTitle}">
          <TextBlock Text="{Binding CurrentTargetTitle}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Добавить блок -->
        <Button x:Name="AddNodeFlyoutButton" Classes="primary" Content="＋ Блок ▾" Margin="0,2,6,2"
                ToolTip.Tip="Каталог блоков логики (или двойной клик по полотну)">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnPaletteOpened" Closed="OnPaletteClosed">
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                      BorderThickness="1" CornerRadius="10" Padding="12" Width="380" MaxHeight="460">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Каталог блоков" Classes="h" Margin="0,0,0,6"/>
                  <TextBox x:Name="PaletteSearch" DockPanel.Dock="Top" Watermark="🔍 Поиск: клик, branch, текст, +, таймер…"
                           Text="{Binding NodeSearchText}" Margin="0,0,0,8" KeyDown="OnPaletteSearchKeyDown"/>
                  <TextBlock DockPanel.Dock="Bottom" Classes="caption" Margin="0,6,0,0"
                             Text="Enter — добавить первый найденный блок · Esc — закрыть"/>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredLibraryNodes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="ev:NodeDescriptor">
                          <Button Classes="catalog-item" Click="OnAddNodeClick">
                            <DockPanel>
                              <Border DockPanel.Dock="Right" Classes="chip" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Category}"/>
                              </Border>
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </DockPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button Classes="soft" Content="📦 Шаблоны ▾" Margin="0,2,6,2" ToolTip.Tip="Готовые механики: заменяют глобальный граф сцены">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="🐱 Кликер (тап + автоклик)" Command="{Binding LoadPresetClickerCommand}"/>
              <MenuItem Header="🪙 Сбор монет (10 монет + UI)" Command="{Binding LoadPresetCoinCollectorCommand}"/>
              <MenuItem Header="🚪 Дверь и ключ" Command="{Binding LoadPresetDoorKeyCommand}"/>
              <MenuItem Header="❤️ Здоровье игрока (HP + опасность)" Command="{Binding LoadPresetHealthCommand}"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Classes="soft" Content="▶ Симуляция" Command="{Binding SimulateCommand}" Margin="0,2,10,2"
                ToolTip.Tip="Проверить выполнение логики графа прямо в редакторе (вкладка «Отладка»)"/>

        <Border Classes="vsep" Height="22"/>

        <!-- Правка выделенного -->
        <StackPanel Orientation="Horizontal" Spacing="1" Margin="0,2,6,2">
          <Button Classes="icon" Content="📋" Command="{Binding CopyNodesCommand}" IsEnabled="{Binding HasAnySelection}" ToolTip.Tip="{Binding TipCopyNodes}"/>
          <Button Classes="icon" Content="📌" Command="{Binding PasteNodesHereCommand}" IsEnabled="{Binding CanPaste}" ToolTip.Tip="{Binding TipPasteNodes}"/>
          <Button Classes="icon" Content="⧉" Command="{Binding DuplicateNodesCommand}" IsEnabled="{Binding HasAnySelection}" ToolTip.Tip="{Binding TipDuplicateNodes}"/>
          <Button Classes="icon" Content="🗂" Command="{Binding GroupSelectionCommand}" IsEnabled="{Binding HasAnySelection}" ToolTip.Tip="{Binding TipGroup}"/>
          <Button Classes="icon" Content="⊟" Command="{Binding UngroupSelectionCommand}" ToolTip.Tip="{Binding TipUngroup}"/>
          <Button Classes="icon" Content="🗑" Command="{Binding DeleteSelectedNodeCommand}" IsEnabled="{Binding HasAnySelection}"
                  Foreground="{DynamicResource DangerBrush}" ToolTip.Tip="{Binding TipDeleteNodes}"/>
        </StackPanel>

        <Border Classes="vsep" Height="22"/>

        <!-- Вид -->
        <StackPanel Orientation="Horizontal" Spacing="1" Margin="0,2,6,2">
          <Button Classes="icon" Content="−" Click="OnZoomOutClick" ToolTip.Tip="Отдалить (колесо мыши)"/>
          <Button Classes="tool" Click="OnZoomResetClick" ToolTip.Tip="Масштаб 100%" MinWidth="52">
            <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          </Button>
          <Button Classes="icon" Content="＋" Click="OnZoomInClick" ToolTip.Tip="Приблизить (колесо мыши)"/>
          <Button Classes="icon" Content="🎯" Click="OnCenterClick" ToolTip.Tip="{Binding TipFit}"/>
          <Button Classes="icon" Content="🧹" Command="{Binding ClearGraphCommand}" ToolTip.Tip="Очистить граф (можно отменить)"/>
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- ================= РАБОЧАЯ ОБЛАСТЬ ================= -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="240" MaxWidth="480"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Боковая панель -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
        <TabControl SelectedIndex="{Binding LeftSidebarTabIndex, Mode=TwoWay}" Padding="0">
          <!-- ===== Свойства ===== -->
          <TabItem Header="Свойства" FontSize="12">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10" Margin="10,8,12,16">

                <!-- Ничего не выбрано -->
                <Border Classes="gcard" IsVisible="{Binding !HasAnySelection}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="👆 Выберите блок" Classes="h" HorizontalAlignment="Center"/>
                    <TextBlock Classes="caption" TextAlignment="Center"
                               Text="Кликните по блоку, чтобы настроить его. Тяните по пустому месту — выделится рамкой несколько блоков."/>
                    <TextBlock Classes="caption" TextAlignment="Center" Text="{Binding CanvasHint}" Opacity="0.85"/>
                  </StackPanel>
                </Border>

                <!-- Группа -->
                <Border Classes="gcard" IsVisible="{Binding HasSelectedGroup}">
                  <StackPanel Spacing="8">
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="Группа"/></Border>
                      <TextBlock Text="🗂 Настройки группы" Classes="h"/>
                    </DockPanel>
                    <TextBlock Text="Название" Classes="label"/>
                    <TextBox Text="{Binding SelectedGroupTitle}" Watermark="Например: Логика клика"/>
                    <TextBlock Text="Цвет рамки" Classes="label"/>
                    <ItemsControl ItemsSource="{Binding GroupColors}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="tool" Padding="3" Margin="0,0,4,4" Click="OnGroupColorClick" Tag="{Binding}" ToolTip.Tip="{Binding}">
                            <Border Width="20" Height="20" CornerRadius="10" Background="{Binding}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                      <Button Classes="soft" Content="⊟ Расформировать" Command="{Binding UngroupSelectionCommand}" Margin="0,0,6,6"
                              ToolTip.Tip="{Binding TipUngroup}"/>
                      <Button Classes="danger" Content="🗑 Удалить с блоками" Command="{Binding DeleteGroupWithNodesCommand}" Margin="0,0,6,6"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Несколько блоков -->
                <Border Classes="gcard" IsVisible="{Binding HasMultipleSelection}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding SelectionSummary}" Classes="h"/>
                    <TextBlock Classes="caption" Text="Перетаскивайте любой из выделенных блоков — сдвинутся все. Стрелки — точный сдвиг (Shift — крупный)."/>
                    <WrapPanel>
                      <Button Classes="soft" Content="🗂 Сгруппировать" Command="{Binding GroupSelectionCommand}" Margin="0,0,6,6" ToolTip.Tip="{Binding TipGroup}"/>
                      <Button Classes="soft" Content="⧉ Дублировать" Command="{Binding DuplicateNodesCommand}" Margin="0,0,6,6" ToolTip.Tip="{Binding TipDuplicateNodes}"/>
                      <Button Classes="soft" Content="📋 Копировать" Command="{Binding CopyNodesCommand}" Margin="0,0,6,6" ToolTip.Tip="{Binding TipCopyNodes}"/>
                      <Button Classes="danger" Content="🗑 Удалить все" Command="{Binding DeleteSelectedNodeCommand}" Margin="0,0,6,6" ToolTip.Tip="{Binding TipDeleteNodes}"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Один блок -->
                <StackPanel IsVisible="{Binding HasSingleSelection}" Spacing="10">
                  <Border Classes="gcard">
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Classes="chip" Margin="6,0,0,0">
                        <TextBlock Text="{Binding SelectedNode.Category}"/>
                      </Border>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding SelectedNode.Title}" Classes="h" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedNode.NodeType, StringFormat='Тип: {0}'}" Classes="caption"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <!-- Set UI Text -->
                  <Border Classes="gcard" IsVisible="{Binding IsUiSetTextSelected}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="🎯 Целевой UI-текст" Classes="label"/>
                      <ComboBox ItemsSource="{Binding AvailableUiTexts}" SelectedItem="{Binding SelectedNodeTargetName}"
                                HorizontalAlignment="Stretch" ToolTip.Tip="Текстовый элемент на экране"/>
                      <TextBlock Text="🏷️ Префикс (перед числом)" Classes="label" Margin="0,4,0,0"/>
                      <TextBox Text="{Binding SelectedNodePrefix}" Watermark="например: Монет: "/>
                      <TextBlock Text="🏷️ Суффикс (после числа)" Classes="label" Margin="0,4,0,0"/>
                      <TextBox Text="{Binding SelectedNodeSuffix}" Watermark="например: шт."/>
                      <Border Classes="banner-success" Margin="0,4,0,0">
                        <TextBlock Text="{Binding SelectedNodePreviewText}" Classes="success" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      </Border>
                    </StackPanel>
                  </Border>

                  <!-- События клика -->
                  <StackPanel IsVisible="{Binding IsClickEventSelected}" Spacing="8">
                    <Border Classes="banner-success" IsVisible="{Binding IsObjectGraph}" Padding="10">
                      <StackPanel Spacing="4">
                        <DockPanel>
                          <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="Автоматически"/></Border>
                          <TextBlock Text="🎯 Локальный клик" FontWeight="Bold" FontSize="12" Classes="success"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TargetObject.Name, StringFormat='Событие привязано к объекту «{0}».'}"
                                   FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Classes="caption" Text="При клике по этому объекту в игре цепочка сработает сразу."/>
                      </StackPanel>
                    </Border>
                    <Border Classes="gcard" IsVisible="{Binding !IsObjectGraph}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="🔘 Целевая кнопка сцены" Classes="label"/>
                        <ComboBox ItemsSource="{Binding AvailableUiButtons}" SelectedItem="{Binding SelectedNodeButtonName}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Выберите кнопку"/>
                        <TextBlock Classes="caption" Text="Клик по какой кнопке запускает эту цепочку."/>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- Переменные -->
                  <Border Classes="gcard" IsVisible="{Binding IsVariableNodeSelected}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="🔢 Переменная" Classes="label"/>
                      <ComboBox ItemsSource="{Binding AvailableVariableNames}" SelectedItem="{Binding SelectedNodeVariableName}"
                                HorizontalAlignment="Stretch" PlaceholderText="Выберите переменную"/>
                    </StackPanel>
                  </Border>

                  <WrapPanel>
                    <Button Classes="soft" Content="⧉ Дублировать" Command="{Binding DuplicateNodesCommand}" Margin="0,0,6,6" ToolTip.Tip="{Binding TipDuplicateNodes}"/>
                    <Button Classes="soft" Content="🗂 В группу" Command="{Binding GroupSelectionCommand}" Margin="0,0,6,6" ToolTip.Tip="{Binding TipGroup}"/>
                    <Button Classes="danger" Content="🗑 Удалить" Command="{Binding DeleteSelectedNodeCommand}" Margin="0,0,6,6" ToolTip.Tip="{Binding TipDeleteNodes}"/>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ===== Каталог блоков ===== -->
          <TabItem Header="Блоки" FontSize="12">
            <DockPanel Margin="10,8,10,8">
              <TextBox DockPanel.Dock="Top" Watermark="🔍 Поиск блоков…" Text="{Binding NodeSearchText}" Margin="0,0,0,8"/>
              <TextBlock DockPanel.Dock="Bottom" Classes="caption" Margin="0,6,0,0"
                         Text="Клик — добавить блок в центр видимой области."/>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredLibraryNodes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="ev:NodeDescriptor">
                      <Button Classes="catalog-item" Click="OnAddNodeClick">
                        <DockPanel>
                          <Border DockPanel.Dock="Right" Classes="chip" Margin="6,0,0,0">
                            <TextBlock Text="{Binding Category}"/>
                          </Border>
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </DockPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <!-- ===== Переменные ===== -->
          <TabItem Header="Переменные" FontSize="12">
            <DockPanel Margin="10,8,10,8">
              <Border DockPanel.Dock="Bottom" Classes="gcard" Margin="0,10,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Text="＋ Новая переменная" Classes="label"/>
                  <TextBox Text="{Binding NewVarName}" Watermark="Имя переменной"/>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="Тип" Classes="label" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding NewVarType}" HorizontalAlignment="Stretch">
                      <ev:PortType>Integer</ev:PortType>
                      <ev:PortType>Boolean</ev:PortType>
                      <ev:PortType>Float</ev:PortType>
                      <ev:PortType>String</ev:PortType>
                    </ComboBox>
                  </Grid>
                  <TextBox Text="{Binding NewVarDefault}" Watermark="Значение по умолчанию"/>
                  <Button Classes="primary" Content="＋ Добавить" Command="{Binding AddVariableCommand}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>
              </Border>

              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Variables}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="ev:GraphVariable">
                        <Border Classes="gcard" Margin="0,0,0,8">
                          <StackPanel Spacing="6">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Classes="tool" Content="✕" Padding="6,2"
                                      Click="OnRemoveVariableClick" Foreground="{DynamicResource DangerBrush}" ToolTip.Tip="Удалить переменную"/>
                              <TextBox Text="{Binding Name, Mode=TwoWay}" FontWeight="Bold" Margin="0,0,6,0" ToolTip.Tip="Имя переменной"/>
                            </DockPanel>
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="6">
                              <ComboBox Grid.Column="0" SelectedItem="{Binding Type, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11">
                                <ev:PortType>Integer</ev:PortType>
                                <ev:PortType>Boolean</ev:PortType>
                                <ev:PortType>Float</ev:PortType>
                                <ev:PortType>String</ev:PortType>
                              </ComboBox>
                              <TextBox Grid.Column="1" Text="{Binding DefaultValue, Mode=TwoWay}" Watermark="Значение"
                                       ToolTip.Tip="Значение по умолчанию"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Button Classes="soft" Content="＋ Get (чтение)" Click="OnSpawnGetVariableClick" FontSize="11" Padding="8,3"/>
                              <Button Classes="soft" Content="＋ Set (запись)" Click="OnSpawnSetVariableClick" FontSize="11" Padding="8,3"/>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock IsVisible="{Binding !Variables.Count}" Classes="caption" Margin="2,4,2,8"
                             Text="Переменных пока нет. Создайте первую ниже — например, Score или Coins."/>

                  <!-- Переменные сцены (из других объектов) -->
                  <Border IsVisible="{Binding HasSharedSceneVariables}" Classes="sunken" Padding="10" Margin="0,4,0,0">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Classes="chip"><TextBlock Text="Общие"/></Border>
                        <TextBlock Text="🌐 Переменные сцены" Classes="h"/>
                      </DockPanel>
                      <TextBlock Classes="caption" Text="Объявлены на сцене или в других объектах. Их можно читать и менять из этого графа."/>
                      <ItemsControl ItemsSource="{Binding SharedSceneVariables}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="ev:GraphVariable">
                            <Border Classes="gcard" Padding="8" Margin="0,4,0,0">
                              <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                  <Button Classes="tool" Content="＋ Get" Click="OnSpawnGetVariableClick" FontSize="10.5"/>
                                  <Button Classes="tool" Content="＋ Set" Click="OnSpawnSetVariableClick" FontSize="10.5"/>
                                </StackPanel>
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Text="{Binding DefaultValue, StringFormat='Значение: {0}'}" Classes="caption"/>
                                </StackPanel>
                              </DockPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <!-- ===== Отладка ===== -->
          <TabItem Header="Отладка" FontSize="12">
            <DockPanel Margin="10,8,10,8">
              <Button DockPanel.Dock="Top" Classes="primary" Content="▶ Запустить симуляцию" Command="{Binding SimulateCommand}"
                      Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              <Border Background="{DynamicResource CodeBgBrush}" CornerRadius="8" Padding="8">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding SimulationLogs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="Menlo,Consolas,monospace"
                                   Foreground="{DynamicResource CodeTextBrush}" TextWrapping="Wrap" Margin="0,1"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

      <!-- ================= ПОЛОТНО ================= -->
      <Grid Grid.Column="2">
        <v:EventGraphCanvas x:Name="CanvasCtrl"/>

        <!-- Счётчик выделения -->
        <Border IsVisible="{Binding HasAnySelection}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                Background="{DynamicResource HudBgBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                CornerRadius="8" Padding="10,4" IsHitTestVisible="False">
          <TextBlock Text="{Binding SelectionSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HudTextBrush}"/>
        </Border>

        <!-- Подсказка по управлению -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10"
                Background="{DynamicResource HudBgBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                CornerRadius="8" Padding="10,5" IsHitTestVisible="False">
          <TextBlock Text="{Binding CanvasHint}" FontSize="10.5" Foreground="{DynamicResource HudTextBrush}"
                     TextWrapping="Wrap" Opacity="0.85"/>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
