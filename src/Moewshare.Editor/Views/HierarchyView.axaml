<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moewshare.Editor.ViewModels"
             x:Class="Moewshare.Editor.Views.HierarchyView"
             x:DataType="vm:HierarchyPanelVM">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <DockPanel>
        <Border DockPanel.Dock="Right" Background="#FCE8EC" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Editor.Objects.Count, StringFormat='{}{0} шт.'}" FontSize="11" FontWeight="Bold" Foreground="#4A2929"/>
        </Border>
        <TextBlock Text="Иерархия сцены" Classes="h" VerticalAlignment="Center"/>
      </DockPanel>

      <Button Classes="primary" Content="✨ + Добавить объект..." Command="{Binding Editor.OpenAddObjectDialogCommand}"
              HorizontalAlignment="Stretch" ToolTip.Tip="Открыть окно создания и добавления объектов на сцену"/>
    </StackPanel>

    <!-- Bottom Actions: Duplicate, Delete, Unparent -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,16">
      <WrapPanel Orientation="Horizontal">
        <Button Classes="soft" Content="Дублировать" Command="{Binding Editor.DuplicateSelectedCommand}" IsEnabled="{Binding Editor.HasSelection}" Margin="0,0,4,4"/>
        <Button Classes="soft" Content="Удалить" Command="{Binding Editor.DeleteSelectedCommand}" IsEnabled="{Binding Editor.HasSelection}" Margin="0,0,4,4"/>
        <Button Classes="primary" Content="🧩 + Компонент" Command="{Binding Editor.OpenAddComponentCommand}" IsEnabled="{Binding Editor.HasSelection}" Margin="0,0,4,4"
                ToolTip.Tip="Добавить компонент на выбранный объект (физика, платформер, коллизии, спрайты)"/>
        <Button Classes="soft" Content="✖ Отвязать" Command="{Binding Editor.UnparentSelectedCommand}" IsEnabled="{Binding Editor.Selected.HasParent}" Margin="0,0,4,4"
                ToolTip.Tip="Отвязать выбранный объект от родителя (вернуть в корень сцены)"/>
      </WrapPanel>
      <TextBlock Text="💡 Перетаскивайте мышкой объекты друг на друга, чтобы привязать (сделать дочерними)!"
                 FontSize="10.5" Opacity="0.6" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Objects List with Visual Parenting Tree Indent -->
    <Border Background="White" BorderBrush="#F1D9DB" BorderThickness="1" CornerRadius="10">
      <ListBox x:Name="ObjectsListBox" ItemsSource="{Binding Editor.DisplayedHierarchyObjects}" SelectedItem="{Binding Editor.Selected}"
               Background="Transparent" SelectionMode="Single">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="CornerRadius" Value="6"/>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ObjectVM">
            <Border Background="{Binding IsSelectedBrush}"
                    BorderBrush="{Binding DropTargetBrush}"
                    BorderThickness="{Binding DropTargetBorderThickness}"
                    CornerRadius="6"
                    Padding="4,3"
                    Margin="{Binding HierarchyIndent}">
              <Border.ContextFlyout>
                <MenuFlyout>
                  <MenuItem Header="✨ Добавить объект..." Command="{Binding Editor.OpenAddObjectDialogCommand}"/>
                  <MenuItem Header="🧩 Добавить компонент..." Command="{Binding OpenAddComponentForThisCommand}"/>
                  <Separator/>
                  <MenuItem Header="🔒 Заблокировать / Разблокировать" Command="{Binding ToggleLockCommand}"/>
                  <MenuItem Header="👁 Скрыть / Показать на сцене" Command="{Binding ToggleVisibilityCommand}"/>
                  <Separator/>
                  <MenuItem Header="📋 Дублировать" Command="{Binding DuplicateThisCommand}"/>
                  <MenuItem Header="✖ Отвязать от родителя" Command="{Binding UnparentThisCommand}" IsVisible="{Binding HasParent}"/>
                  <Separator/>
                  <MenuItem Header="🗑️ Удалить" Command="{Binding DeleteThisCommand}"/>
                </MenuFlyout>
              </Border.ContextFlyout>
              <DockPanel Background="Transparent">
                <!-- Right tools: Lock, Eye, Type badge -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <!-- Lock toggle button (🔒 / 🔓) -->
                  <Button Classes="tool" Content="{Binding LockIcon}" Opacity="{Binding LockOpacity}"
                          ToolTip.Tip="{Binding LockTooltip}"
                          Command="{Binding ToggleLockCommand}"
                          Width="22" Height="22" Padding="0" FontSize="11" Margin="0,0,1,0"/>

                  <!-- Eye visibility button (👁 / 🚫) -->
                  <Button Classes="tool" Content="{Binding VisibilityIcon}"
                          ToolTip.Tip="{Binding VisibilityTooltip}"
                          Command="{Binding ToggleVisibilityCommand}"
                          Width="22" Height="22" Padding="0" FontSize="11" Margin="0,0,3,0"/>

                  <!-- Type badge -->
                  <Border Background="#F7E8EB" CornerRadius="4" Padding="4,1">
                    <TextBlock Text="{Binding Type}" Opacity="0.75" FontSize="9.5" FontWeight="SemiBold" Foreground="#4A2929"/>
                  </Border>
                </StackPanel>

                <!-- Left: Foldout arrow (▼/▶) + Spacer + Chain (└─ 🔗) + Type icon + Name -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Opacity="{Binding VisibilityOpacity}">
                  <!-- Foldout arrow button -->
                  <Button Classes="tool" Content="{Binding ExpandIcon}"
                          IsVisible="{Binding HasChildren}"
                          Command="{Binding ToggleExpandedCommand}"
                          Width="16" Height="16" Padding="0" Margin="0,0,2,0" FontSize="10"
                          ToolTip.Tip="Свернуть / развернуть дочерние объекты"/>

                  <!-- Spacer if no children -->
                  <Border Width="16" Height="16" IsVisible="{Binding HasNoChildren}" Margin="0,0,2,0"/>

                  <!-- Chain branch indicator -->
                  <TextBlock Text="{Binding ChainBranchIcon}" FontSize="11" FontWeight="Bold" Foreground="#FF4B72"
                             VerticalAlignment="Center" IsVisible="{Binding HasParent}"/>

                  <!-- Type icon -->
                  <TextBlock Text="{Binding HierarchyTypeIcon}" FontSize="12" VerticalAlignment="Center" Opacity="0.85"/>

                  <!-- Name -->
                  <TextBlock Text="{Binding Name}" FontWeight="{Binding NameFontWeight}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</UserControl>
