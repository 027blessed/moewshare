<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moewshare.Editor.ViewModels"
             x:Class="Moewshare.Editor.Views.ConsoleView"
             x:DataType="vm:ConsolePanelVM">
  <DockPanel Margin="8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <Button DockPanel.Dock="Right" Classes="soft" Content="🗑 Очистить" Command="{Binding Editor.ClearConsoleCommand}"
              ToolTip.Tip="Очистить консоль"/>
      <WrapPanel VerticalAlignment="Center">
        <Border Classes="chip" Margin="0,0,6,0">
          <TextBlock Text="{Binding Editor.ConsoleEntries.Count, StringFormat='Всего: {0}'}"/>
        </Border>
        <Border Classes="banner-danger" Padding="6,2" Margin="0,0,6,0" IsVisible="{Binding Editor.ErrorCount}">
          <TextBlock Text="{Binding Editor.ErrorCount, StringFormat='❌ Ошибок: {0}'}" Classes="danger" FontSize="11" FontWeight="Bold"/>
        </Border>
        <Border Classes="banner-warning" Padding="6,2" Margin="0,0,6,0" IsVisible="{Binding Editor.WarningCount}">
          <TextBlock Text="{Binding Editor.WarningCount, StringFormat='⚠️ Предупреждений: {0}'}" Classes="warning" FontSize="11" FontWeight="Bold"/>
        </Border>
      </WrapPanel>
    </DockPanel>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
      <Grid>
        <ListBox ItemsSource="{Binding Editor.ConsoleEntries}" FontFamily="Menlo,Consolas,monospace" FontSize="12">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:ConsoleEntry">
              <DockPanel Margin="2">
                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeFormatted}" Classes="muted" Width="64"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Message}" Classes="log-msg" Classes.err="{Binding IsError}"
                           Classes.warn="{Binding IsWarning}" Classes.ok="{Binding IsSuccess}" TextWrapping="Wrap"/>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock IsVisible="{Binding !Editor.ConsoleEntries.Count}" Text="Сообщений пока нет" Classes="caption"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
