<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moewshare.Editor.ViewModels"
             x:Class="Moewshare.Editor.Views.ConsoleView"
             x:DataType="vm:ConsolePanelVM">
  <DockPanel Margin="8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <Button DockPanel.Dock="Right" Classes="soft" Content="🗑 Очистить" Command="{Binding Editor.ClearConsoleCommand}"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Border Background="#FCE8EC" CornerRadius="6" Padding="6,2">
          <TextBlock Text="{Binding Editor.ConsoleEntries.Count, StringFormat='Всего: {0}'}" FontSize="11" FontWeight="SemiBold"/>
        </Border>
        <Border Background="#FDEDEC" CornerRadius="6" Padding="6,2" IsVisible="{Binding Editor.ErrorCount}">
          <TextBlock Text="{Binding Editor.ErrorCount, StringFormat='❌ Ошибок: {0}'}" Foreground="#E74C3C" FontSize="11" FontWeight="Bold"/>
        </Border>
        <Border Background="#FEF9E7" CornerRadius="6" Padding="6,2" IsVisible="{Binding Editor.WarningCount}">
          <TextBlock Text="{Binding Editor.WarningCount, StringFormat='⚠️ Предупреждений: {0}'}" Foreground="#F39C12" FontSize="11" FontWeight="Bold"/>
        </Border>
      </StackPanel>
    </DockPanel>

    <Border Background="White" BorderBrush="#F1D9DB" BorderThickness="1" CornerRadius="10">
      <ListBox ItemsSource="{Binding Editor.ConsoleEntries}" Background="Transparent" FontFamily="Consolas,Menlo,monospace" FontSize="12">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ConsoleEntry">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2">
              <TextBlock Text="{Binding TimeFormatted}" Opacity="0.5" Width="60"/>
              <TextBlock Text="{Binding Icon}"/>
              <TextBlock Text="{Binding Message}" Foreground="{Binding BadgeBrush}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</UserControl>
