<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moewshare.Editor.ViewModels"
             x:Class="Moewshare.Editor.Views.GameView"
             x:DataType="vm:GamePanelVM">
  <ScrollViewer Padding="12" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12">
      <!-- Статус сервера -->
      <Border Classes="card" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button Classes="primary" Content="▶ Запустить" Command="{Binding Editor.RunCommand}" IsVisible="{Binding !Editor.IsRunning}"
                    ToolTip.Tip="{Binding Editor.TipRun}"/>
            <Button Classes="danger" Content="■ Остановить" Command="{Binding Editor.StopCommand}" IsVisible="{Binding Editor.IsRunning}"
                    ToolTip.Tip="{Binding Editor.TipStop}"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Panel Width="12" Height="12" VerticalAlignment="Center">
                <Border CornerRadius="6" Background="{DynamicResource SuccessBrush}" IsVisible="{Binding Editor.IsRunning}"/>
                <Border CornerRadius="6" Background="{DynamicResource Text3Brush}" IsVisible="{Binding !Editor.IsRunning}"/>
              </Panel>
              <TextBlock Text="Сервер активен — игра запущена" Classes="success" FontWeight="Bold" FontSize="14"
                         IsVisible="{Binding Editor.IsRunning}" VerticalAlignment="Center"/>
              <TextBlock Text="Сервер игры остановлен" Classes="muted" FontWeight="Bold" FontSize="14"
                         IsVisible="{Binding !Editor.IsRunning}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Classes="caption" FontSize="12"
                       Text="Движок поднимает изолированный локальный HTTP-сервер на 127.0.0.1 для проверки игры в браузере."/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Экспорт -->
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="Экспорт игры в Web (Babylon.js)" Classes="h"/>
          <TextBlock Classes="caption" FontSize="12"
                     Text="Готовая сборка появится в папке Build/web/ — её можно загрузить на любой хостинг (GitHub Pages, itch.io, Vercel и др.)."/>
          <WrapPanel Margin="0,4,0,0">
            <Button Classes="primary" Content="📦 Собрать игру (Web)" Command="{Binding Editor.BuildCommand}" Margin="0,0,8,6"
                    ToolTip.Tip="{Binding Editor.TipBuild}"/>
            <Button Classes="soft" Content="📂 Папка проекта" Command="{Binding Editor.OpenProjectFolderCommand}" Margin="0,0,8,6"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
