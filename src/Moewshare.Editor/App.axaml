<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Moewshare.Editor.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Moewshare.Editor/Styles/Palette.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#E05263" RegionColor="#FFFFFF" ErrorText="#C0392B"/>
        <ColorPaletteResources x:Key="Dark" Accent="#E8607A" RegionColor="#1E1920" ErrorText="#FF7A85"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Moewshare.Editor/Styles/Controls.axaml"/>
  </Application.Styles>
</Application>
