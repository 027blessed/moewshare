<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Moewshare.Launcher.Views.SettingsView">
  <ScrollViewer>
    <StackPanel Margin="32,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="Настройки"/>
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Папка проектов"/>
          <DockPanel><Button DockPanel.Dock="Right" Classes="soft" Margin="8,0,0,0" Content="Обзор…" Command="{Binding BrowseProjectsCommand}"/><TextBox Text="{Binding ProjectsFolder}"/></DockPanel>
          <TextBlock Classes="h2" Text="Папка установок редактора"/>
          <DockPanel><Button DockPanel.Dock="Right" Classes="soft" Margin="8,0,0,0" Content="Обзор…" Command="{Binding BrowseEnginesCommand}"/><TextBox Text="{Binding EnginesFolder}"/></DockPanel>
          <TextBlock Classes="muted" Text="Найденные редакторы:"/>
          <ItemsControl ItemsSource="{Binding InstalledEditors}">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Общие"/>
          <TextBlock Classes="muted" Text="Язык интерфейса: русский · Тема: светлая (другие пока не реализованы)"/>
          <CheckBox IsChecked="{Binding AutoCheckUpdates}" Content="Автоматически проверять обновления"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="soft" Content="Открыть папку журналов" Command="{Binding OpenLogsCommand}"/>
            <Button Classes="soft" Content="Очистить временные файлы" Command="{Binding ClearTempCommand}"/>
            <Button Classes="soft" Content="Сбросить настройки" Command="{Binding ResetCommand}"/>
          </StackPanel>
          <TextBlock Foreground="#C0392B" Text="{Binding Info}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock Classes="muted" Text="{Binding LauncherVersion}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
