<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Moewshare.Launcher.Views.NewProjectView">
  <DockPanel Margin="32,24">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="Новый проект"/>
      <TextBlock Classes="muted" Text="{Binding StepTitle}"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Foreground="#C0392B" Margin="0,0,0,8" Text="{Binding Error}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Classes="soft" Content="Отмена" Command="{Binding CancelCommand}"/>
          <Button Classes="soft" Content="Назад" IsVisible="{Binding CanBack}" Command="{Binding BackCommand}"/>
          <Button Classes="primary" Content="Далее" IsVisible="{Binding !IsStep2}" Command="{Binding NextCommand}"/>
          <Button Classes="primary" Content="Создать проект" IsVisible="{Binding IsStep2}" IsEnabled="{Binding !Busy}" Command="{Binding CreateCommand}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid>
      <ListBox IsVisible="{Binding IsStep0}" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" Background="Transparent">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="230" Spacing="6" Margin="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Background="{DynamicResource AccentBrush}" CornerRadius="999" Padding="10,3"><TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="Bold"/></Border>
                <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Classes="h2" Text="{Binding Name}"/>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Description}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Classes="card" IsVisible="{Binding IsStep1}" VerticalAlignment="Top" MaxWidth="640" HorizontalAlignment="Left">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Название проекта"/>
          <TextBox Text="{Binding Name}" Watermark="Например: Моя первая игра"/>
          <TextBlock Classes="h2" Text="Папка сохранения"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="soft" Margin="8,0,0,0" Content="Обзор…" Command="{Binding BrowseCommand}"/>
            <TextBox Text="{Binding ParentFolder}"/>
          </DockPanel>
          <TextBlock Classes="h2" Text="Версия редактора"/>
          <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" MinWidth="200" PlaceholderText="Редактор не установлен"/>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding IsStep2}" VerticalAlignment="Top" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="22"/>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
