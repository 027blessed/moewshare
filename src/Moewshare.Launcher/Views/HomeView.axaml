<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moewshare.Launcher.ViewModels"
             x:Class="Moewshare.Launcher.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,24" Spacing="26">
      <!-- Hero Banner -->
      <Border Classes="card" Background="{DynamicResource AccentBrush}" Padding="28">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="h1" Text="Твори свою игру!"/>
              <TextBlock Text="🐾" FontSize="26" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="От первой идеи до собственной 2D или 3D игры в браузере" FontSize="15" Opacity=".8"/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
              <Button Classes="primary" Command="{Binding OpenEditorCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="▶"/>
                  <TextBlock Text="Открыть редактор"/>
                </StackPanel>
              </Button>
              <Button Classes="soft" Background="White" Command="{Binding NewProjectCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="✨"/>
                  <TextBlock Text="Новый проект"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <!-- Mascot Logo -->
          <Border Grid.Column="1" CornerRadius="20" ClipToBounds="True" Height="140" Width="140"
                  BorderBrush="White" BorderThickness="3" BoxShadow="0 8 20 0 #20000000">
            <Image Source="avares://Moewshare.Launcher/Assets/icon.png" Stretch="UniformToFill"/>
          </Border>
        </Grid>
      </Border>

      <!-- Missing Editor Notification -->
      <Border Classes="card" IsVisible="{Binding EditorMissing}" Background="#FFF0F3" BorderBrush="#F7CDD5">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="primary" Content="Настройки редактора" Command="{Binding GoSettingsCommand}"/>
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center"/>
              <TextBlock Classes="h2" Text="Редактор Moewshare ещё не установлен" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Укажите путь к Moewshare.Editor или скачайте готовый архив из дистрибутива."/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Recent Projects -->
      <StackPanel Spacing="14">
        <DockPanel>
          <TextBlock Classes="h2" FontSize="20" Text="Недавние проекты" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Classes="card" Background="White" Padding="24" IsVisible="{Binding !HasRecent}">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="🐱" FontSize="36" HorizontalAlignment="Center"/>
            <TextBlock Classes="h2" Text="Проектов пока нет" HorizontalAlignment="Center"/>
            <TextBlock Classes="muted" Text="Создайте свой первый проект из шаблонов ниже." HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ProjectCardTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>

      <!-- Starter Templates -->
      <StackPanel Spacing="14">
        <TextBlock Classes="h2" FontSize="20" Text="Начать с чистого шаблона"/>
        <ItemsControl ItemsSource="{Binding Templates}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Width="280" Margin="0,0,18,18">
                <StackPanel Spacing="10">
                  <!-- Header Pill -->
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{DynamicResource AccentBrush}" CornerRadius="999" Padding="10,3">
                      <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="Bold" Foreground="#4A2929"/>
                    </Border>
                    <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="999" Padding="10,3">
                      <TextBlock Text="{Binding Status}" FontSize="11" Classes="muted"/>
                    </Border>
                  </DockPanel>

                  <TextBlock Classes="h2" Text="{Binding Name}" FontWeight="Bold"/>
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Height="36" Text="{Binding Description}"/>

                  <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding $parent[ItemsControl].DataContext.StartTemplateCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="✨"/>
                      <TextBlock Text="Создать игру"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
