<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#FFF4F3"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#F7CDD5"/>
    <SolidColorBrush x:Key="TextBrush" Color="#482C30"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#98777B"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4A2929"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="#F1D9DB"/>
    <StreamGeometry x:Key="IconHome">M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
    <StreamGeometry x:Key="IconGrid">M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z</StreamGeometry>
    <StreamGeometry x:Key="IconBook">M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z</StreamGeometry>
    <StreamGeometry x:Key="IconSliders">M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 14v2h8v-2h-8zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
    <StreamGeometry x:Key="IconHeart">M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z</StreamGeometry>

    <DataTemplate x:Key="ProjectCardTemplate">
      <Border Classes="card" Width="280" Margin="0,0,18,18"
              Tag="{Binding $parent[ItemsControl].DataContext}">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="▶ Открыть в редакторе" Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.OpenCommand}" CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}"/>
            <MenuItem Header="📁 Показать в папке" Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.RevealCommand}" CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}"/>
            <MenuItem Header="✏️ Переименовать" Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.RenameCommand}" CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}"/>
            <MenuItem Header="⚡ Версия редактора…" Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.ChangeVersionCommand}" CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}"/>
            <Separator/>
            <MenuItem Header="✖ Убрать из списка недавних" Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.RemoveCommand}" CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}"/>
            <MenuItem Header="🗑️ Удалить проект с диска…" Command="{Binding $parent[ContextMenu].PlacementTarget.Tag.DeleteCommand}" CommandParameter="{Binding $parent[ContextMenu].PlacementTarget.DataContext}"/>
          </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Spacing="10">
          <!-- Card Banner -->
          <Border Height="92" CornerRadius="14" Background="{StaticResource AccentBrush}" ClipToBounds="True">
            <Panel>
              <!-- Center Big Kind Icon / Stamp -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6" Opacity="0.55">
                <TextBlock Text="{Binding KindIcon}" FontSize="36" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding KindLabel}" FontSize="28" FontWeight="ExtraBold" VerticalAlignment="Center"/>
              </StackPanel>

              <!-- Top Left: Kind Pill -->
              <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                      Background="White" CornerRadius="999" Padding="8,3" BoxShadow="0 2 6 0 #20000000">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding KindIcon}" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="Bold" Foreground="#4A2929" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- Top Right: Favorite & Quick Hide Buttons -->
              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="4" Margin="6">
                <!-- Favorite -->
                <Button Classes="icon" ToolTip.Tip="В избранное"
                        Command="{Binding $parent[ItemsControl].DataContext.ToggleFavoriteCommand}" CommandParameter="{Binding}">
                  <Panel>
                    <Path Classes="ico" Data="{StaticResource IconHeart}" Fill="#98777B" Opacity=".4" IsVisible="{Binding !IsFavorite}"/>
                    <Path Classes="ico" Data="{StaticResource IconHeart}" Fill="#E05263" IsVisible="{Binding IsFavorite}"/>
                  </Panel>
                </Button>
                <!-- Quick Remove from list -->
                <Button Classes="icon" ToolTip.Tip="Убрать из списка (файлы на диске останутся)"
                        Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}" CommandParameter="{Binding}">
                  <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="#98777B" Opacity="0.7"/>
                </Button>
              </StackPanel>
            </Panel>
          </Border>

          <!-- Title and Info -->
          <StackPanel Spacing="4">
            <DockPanel>
              <TextBlock Text="{Binding Name}" Classes="h2" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="{Binding ShortFolder}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Folder}"/>

            <!-- Metadata badges -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
              <Border Background="#FFF0F3" CornerRadius="6" Padding="6,2">
                <TextBlock Text="{Binding EngineVersion, StringFormat='⚡ v{0}', FallbackValue='⚡ v0.1.0'}" FontSize="10" FontWeight="SemiBold" Foreground="#4A2929"/>
              </Border>
              <Border Background="#F5F5F7" CornerRadius="6" Padding="6,2">
                <TextBlock Text="{Binding DisplayDate, StringFormat='🕒 {0}'}" FontSize="10" Foreground="#888888"/>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Missing Folder Alert and Quick Remove -->
          <StackPanel IsVisible="{Binding HasProblem}" Spacing="6" Margin="0,2,0,0">
            <Border Background="#FDECEF" BorderBrush="#F1A5B5" BorderThickness="1" CornerRadius="10" Padding="10,6">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="⚠️" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#C0392B" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <Button Classes="soft" Background="#FDECEF" Foreground="#C0392B"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="🗑️ Убрать из списка"
                    Command="{Binding $parent[ItemsControl].DataContext.RemoveMissingCommand}" CommandParameter="{Binding}"/>
          </StackPanel>

          <!-- Normal Actions -->
          <StackPanel IsVisible="{Binding !HasProblem}" Spacing="6">
            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="▶ Открыть в редакторе"
                    Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}" CommandParameter="{Binding}"/>

            <!-- Action buttons row: Reveal, Rename, Delete -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
              <Button Classes="soft" Padding="4,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      ToolTip.Tip="Открыть папку проекта"
                      Command="{Binding $parent[ItemsControl].DataContext.RevealCommand}" CommandParameter="{Binding}">
                <TextBlock Text="📁 Папка" FontSize="11"/>
              </Button>
              <Button Grid.Column="1" Classes="soft" Padding="4,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      ToolTip.Tip="Переименовать проект"
                      Command="{Binding $parent[ItemsControl].DataContext.RenameCommand}" CommandParameter="{Binding}">
                <TextBlock Text="✏️ Имя" FontSize="11"/>
              </Button>
              <Button Grid.Column="2" Classes="soft" Padding="4,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      ToolTip.Tip="Удалить проект с диска"
                      Command="{Binding $parent[ItemsControl].DataContext.DeleteCommand}" CommandParameter="{Binding}">
                <TextBlock Text="🗑️ Удалить" FontSize="11" Foreground="#C0392B"/>
              </Button>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Styles.Resources>

  <Style Selector="Window"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="ExtraBold"/></Style>
  <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/></Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="BoxShadow" Value="0 6 18 0 #14482C30"/>
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#6B3D3D"/><Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.soft">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.soft:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F3B9C5"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.tab.active">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FBE3E8"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="6"/><Setter Property="CornerRadius" Value="10"/>
  </Style>
  <Style Selector="Path.ico">
    <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="12,9"/>
    <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
  </Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="12"/></Style>
</Styles>
