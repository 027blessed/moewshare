<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moewshare.Launcher.ViewModels"
             xmlns:views="using:Moewshare.Launcher.Views"
             x:Class="Moewshare.Launcher.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel"><views:HomeView/></DataTemplate>
    <DataTemplate DataType="vm:ProjectsViewModel"><views:ProjectsView/></DataTemplate>
    <DataTemplate DataType="vm:NewProjectViewModel"><views:NewProjectView/></DataTemplate>
    <DataTemplate DataType="vm:LibraryViewModel"><views:LibraryView/></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView/></DataTemplate>
  </Application.DataTemplates>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Moewshare.Launcher/Styles/Palette.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#E05263" RegionColor="#FFFFFF" ErrorText="#C0392B"/>
        <ColorPaletteResources x:Key="Dark" Accent="#E8607A" RegionColor="#1E1920" ErrorText="#FF7A85"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Moewshare.Launcher/Styles/Theme.axaml"/>
  </Application.Styles>
</Application>
